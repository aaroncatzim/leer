<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Electron (Chromium) necesita estas dos con el runtime endurecido. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- OCR con tesseract.js (wasm). -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
  <!-- Descarga de URLs (extractor HTML) y llamadas a las APIs de voz. -->
  <key>com.apple.security.network.client</key>
  <true/>
  <!-- Abrir PDF/HTML elegidos en el diálogo y exportar el MP3. -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
